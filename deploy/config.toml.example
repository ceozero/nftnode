[auth]
# Change this before exposing the panel.
password = "change-me-now"

[server]
port = 3456

[https]
enabled = false
cert_file = "/app/data/certificate/cert.pem"
key_file = "/app/data/certificate/private.key"

[nftables]
config_path = "/etc/nftables.conf"
rules_path = "/etc/nft-forward/rules.json"

[realm]
config_path = "/etc/realm/config.toml"
rules_path = "/etc/nft-forward/realm_rules.json"

[telegram]
enabled = false
bot_token = ""
chat_id = ""
daily_report = false
report_time = "08:00"
alert_quota = false
alert_gfw = false

[session]
# secret = "replace-with-a-random-value"

[metrics]
# token = "replace-with-a-random-value"
